{
  "info": {
    "_postman_id": "b27795bb-7742-4d68-9b6a-987cbf36b49f",
    "name": "StudyFlow API",
    "description": "Runnable requests and automated checks for the StudyFlow API. Select a Postman environment to override the collection's localhost default.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = pm.variables.get('base_url');",
          "if (!baseUrl || !/^https?:\\/\\//.test(baseUrl)) {",
          "  throw new Error('base_url must be an absolute http(s) URL. Select an environment or update the collection variable.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Service",
      "description": "Service health and API contract endpoints.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Checks that the API process is alive. This endpoint has no database dependency."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('matches the health contract', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('service', 'status', 'version');",
                  "  pm.expect(body.service).to.eql('studyflow-api');",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.version).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Database readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ready",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ready"
              ]
            },
            "description": "Checks that the API can reach PostgreSQL. A 503 response means the process is alive but the database is unavailable."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('matches the readiness contract', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('service', 'status', 'database');",
                  "  pm.expect(body.service).to.eql('studyflow-api');",
                  "  pm.expect(body.status).to.eql('ready');",
                  "  pm.expect(body.database).to.eql('reachable');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI schema",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/openapi.json",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "openapi.json"
              ]
            },
            "description": "Fetches the generated API contract used by Swagger UI and client tooling."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns the StudyFlow OpenAPI contract', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.openapi).to.match(/^3\\./);",
                  "  pm.expect(body.info.title).to.eql('StudyFlow API');",
                  "  pm.expect(body.paths).to.have.property('/api/v1/health');",
                  "  pm.expect(body.paths).to.have.property('/api/v1/ready');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Email authentication and account-security endpoints.",
      "item": [
        {
          "name": "Register with email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"name\": \"Student Name\",\n  \"password\": \"correct horse battery staple\",\n  \"timezone\": \"Asia/Phnom_Penh\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates an unverified email/password account when eligible and sends an eight-hour single-use verification link. The response is intentionally non-enumerating."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 202', () => pm.response.to.have.status(202));",
                  "pm.test('returns a non-enumerating response', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('message');",
                  "  pm.expect(body.message).to.eql('Check your email to continue registration if the address is eligible.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"correct horse battery staple\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates a verified password account, sets the secure opaque session cookie, and returns the CSRF token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns account and CSRF token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('account', 'csrf_token');",
                  "  pm.collectionVariables.set('csrf_token', body.csrf_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/session",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "session"]
            },
            "description": "Validates the opaque session cookie and refreshes its idle expiry."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrf_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Validates CSRF, revokes the server session, and clears both browser cookies."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 204', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/resend-verification",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "resend-verification"]
            },
            "description": "Returns a non-enumerating response and rotates the verification token for an eligible unverified account."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 202', () => pm.response.to.have.status(202));"] } }]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Returns a non-enumerating response and sends a one-hour reset link when the verified password account is eligible."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 202', () => pm.response.to.have.status(202));"] } }]
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"paste-password-reset-token-here\",\n  \"password\": \"a new secure password phrase\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "description": "Consumes the one-hour single-use token, updates the password, and revokes all existing sessions."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 204', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"paste-verification-token-here\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-email",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "verify-email"
              ]
            },
            "description": "Consumes an unexpired single-use token and marks the account's email as verified."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Account",
      "description": "Authenticated, student-owned account settings.",
      "item": [
        {
          "name": "Get account profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/account/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "account", "profile"]
            },
            "description": "Returns the authenticated student's immutable ID and email plus editable display name."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Update account profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Student Name\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/account/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "account", "profile"]
            },
            "description": "Updates only the authenticated student's profile name and requires the session-bound CSRF token."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get study preferences",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/account/preferences",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "account", "preferences"]
            },
            "description": "Returns the account timezone, session length, break preference, and whether recurring availability needs reconfirmation."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Update study preferences",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timezone\": \"Asia/Phnom_Penh\",\n  \"preferred_session_length_minutes\": 60,\n  \"minimum_break_minutes\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/account/preferences",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "account", "preferences"]
            },
            "description": "Updates validated planning preferences. A timezone change marks recurring availability for confirmation without changing stored deadline instants."
          },
          "response": [],
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "API origin without a trailing slash. Postman environments override this default."
    },
    {
      "key": "csrf_token",
      "value": "",
      "type": "string",
      "description": "Automatically populated by the email login request."
    }
  ]
}
