# Evaluation environment configuration template per SPEC §24.4
STUDYFLOW_ENVIRONMENT=evaluation
STUDYFLOW_DEBUG=false
STUDYFLOW_LOG_LEVEL=INFO

# Dedicated Evaluation Database
POSTGRES_DB=studyflow_eval
POSTGRES_USER=studyflow_eval
POSTGRES_PASSWORD=studyflow_eval
STUDYFLOW_DATABASE_URL=postgresql+psycopg://studyflow_eval:studyflow_eval@127.0.0.1:55432/studyflow_eval

# Local test SMTP and application endpoints
STUDYFLOW_SMTP_HOST=localhost
STUDYFLOW_SMTP_PORT=1025
STUDYFLOW_EMAIL_FROM_ADDRESS=evaluation-no-reply@studyflow.local
STUDYFLOW_PUBLIC_APP_URL=http://localhost:3000
