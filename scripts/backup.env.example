# Copy this file to scripts/backup.env. The real file is ignored by Git.
# Use a direct Neon URL. Do not use the runtime URL containing -pooler.
export STUDYFLOW_BACKUP_NEON_URL='postgresql://BACKUP_USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require'

# This file contains the shared public age recipient, not the private identity.
export STUDYFLOW_BACKUP_AGE_RECIPIENTS_FILE='/secure/path/studyflow-recipients.txt'

export STUDYFLOW_BACKUP_RCLONE_REMOTE='studyflow-drive'
export STUDYFLOW_BACKUP_RCLONE_PATH='Projects/StudyFlow/Production Backups'

# Optional. Set this to a mounted USB or another local device for the second copy.
# export STUDYFLOW_BACKUP_OFFLINE_DIR='/Volumes/StudyFlow-Backup'
