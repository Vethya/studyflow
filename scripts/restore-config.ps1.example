# Copy this file to scripts/restore-config.ps1. The real file is ignored by Git.
# Use a local downloaded backup folder and an explicit restore target.
$env:STUDYFLOW_RESTORE_BACKUP_DIR = "C:\path\to\downloaded-backup"
$env:STUDYFLOW_RESTORE_DATABASE_URL = 'postgresql://studyflow:studyflow@127.0.0.1:5432/studyflow_restore'
$env:STUDYFLOW_RESTORE_AGE_IDENTITY_FILE = "C:\secure\studyflow-backup-private-key.txt"

# Optional evidence metadata. These values are copied into the committed report,
# so record the operator as a role and leave out the private Drive folder path.
# $env:STUDYFLOW_RESTORE_TARGET_LABEL = "Local Docker PostgreSQL studyflow_restore"
# $env:STUDYFLOW_RESTORE_OPERATOR = "project maintainer"
# $env:STUDYFLOW_RESTORE_SOURCE_ENVIRONMENT = "production"
# $env:STUDYFLOW_RESTORE_SOURCE_NEON_PROJECT = "not recorded"
# $env:STUDYFLOW_RESTORE_SOURCE_NEON_BRANCH = "not recorded"
# $env:STUDYFLOW_RESTORE_GOOGLE_DRIVE_PATH = "private backup folder"
# $env:STUDYFLOW_RESTORE_OFFLINE_COPY_PATH = "not recorded"
# $env:STUDYFLOW_RESTORE_EVIDENCE_FILE = "docs/evidence/backup-restore-2026-09-07.md"
