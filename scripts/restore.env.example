# Copy this file to scripts/restore.env. The real file is ignored by Git.
# Point this at a downloaded backup folder containing exactly one .dump.age,
# one .metadata.txt, and one .sha256 file.
export STUDYFLOW_RESTORE_BACKUP_DIR='/secure/path/downloaded-backup'

# Use an empty local restore database by default. For Neon, use a separate project
# and a direct URL, then pass --allow-remote --yes.
export STUDYFLOW_RESTORE_DATABASE_URL='postgresql://studyflow:studyflow@127.0.0.1:5432/studyflow_restore'
export STUDYFLOW_RESTORE_AGE_IDENTITY_FILE='/secure/path/studyflow-backup-private-key.txt'

# Optional evidence metadata.
# export STUDYFLOW_RESTORE_TARGET_LABEL='Local Docker PostgreSQL studyflow_restore'
# export STUDYFLOW_RESTORE_OPERATOR='Your name'
# export STUDYFLOW_RESTORE_SOURCE_ENVIRONMENT='production'
# export STUDYFLOW_RESTORE_SOURCE_NEON_PROJECT='not recorded'
# export STUDYFLOW_RESTORE_SOURCE_NEON_BRANCH='not recorded'
# export STUDYFLOW_RESTORE_GOOGLE_DRIVE_PATH='Projects/StudyFlow/Production Backups/2026/09/07/B11_...'
# export STUDYFLOW_RESTORE_OFFLINE_COPY_PATH='not recorded'
# export STUDYFLOW_RESTORE_EVIDENCE_FILE='docs/evidence/backup-restore-2026-09-07.md'
